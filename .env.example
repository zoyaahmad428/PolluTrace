# Copy to .env (never commit it) or set these in your shell. PolluTrace reads plain
# environment variables; a key can also live in ../work/secrets/llm_key.txt.

# OpenAI-compatible endpoint. Default: Google Gemini.
# Default: Gemini; a Claude key (sk-ant-...) selects https://api.anthropic.com/v1 automatically.
POLLUTRACE_LLM_BASE_URL=
# Empty = discover the newest available "flash" model; the model used is recorded per result row.
POLLUTRACE_LLM_MODEL=
POLLUTRACE_LLM_API_KEY=your-key-here

# Optional
# POLLUTRACE_WORK=../work            # toolchains, project checkouts, logs
# POLLUTRACE_B2_DOCKER=1             # force iFixFlakies (B2) inside Docker (1) or native (0)
